# ============================================================
# InfraForge (banco + storage + identidade)
# ============================================================
INFRAFORGE_URL="https://infraforge.digitalforge.ia.br"
INFRAFORGE_API_KEY="if_xxxxxxxxxxxxxxxx"
INFRAFORGE_PROJECT="auto-portfolio-ai"
# URL publica base do bucket de storage (objetos em resumes/ devem ser publicos)
INFRAFORGE_STORAGE_PUBLIC_URL="https://auto-portfolio-ai.storage.infraforge.digitalforge.ia.br"
# Conta de servico InfraForge (ja aprovada) usada para ler dados nas
# paginas publicas - o SDK nao permite query sem token.
INFRAFORGE_SERVICE_EMAIL="service@auto-portfolio-ai.local"
INFRAFORGE_SERVICE_PASSWORD="senha-forte-da-conta-de-servico"

# ============================================================
# GitHub OAuth App proprio (Plano B - token com escopo repo)
# Criar em: GitHub > Settings > Developer settings > OAuth Apps
# Callback: <APP_URL>/api/auth/github/callback
# Escopo necessario: read:user user:email repo
# ============================================================
GH_CLIENT_ID="your-github-oauth-app-client-id"
GH_CLIENT_SECRET="your-github-oauth-app-client-secret"

# URL base da aplicacao (usada no callback do OAuth)
APP_URL="http://localhost:3300"

# Chave AES para criptografar o github access_token gravado em
# github_credentials. Gere com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="64-hex-chars"

# Segredo para assinar o cookie de sessao. openssl rand -base64 32
SESSION_COOKIE_SECRET="your-session-cookie-secret"

# ============================================================
# Migracao de dados (Fase 5) - usado apenas por infraforge/migrate.mjs
# Connection string do Postgres antigo (Neon). Pode remover apos migrar.
# ============================================================
NEON_DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ============================================================
# IA (OpenAI ou DeepSeek) - configurada no servidor
# ============================================================
OPENAI_API_KEY="your-openai-or-deepseek-api-key"
# Escolha o provider: 'openai' ou 'deepseek'
AI_PROVIDER="openai"
